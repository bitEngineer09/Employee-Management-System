generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// enums data
enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE_PAID
  LEAVE_UNPAID
}

enum AttendanceAction {
  AUTO_ABSENT
  CHECK_IN
  CHECK_OUT
  UPDATE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  CASUAL
  SICK
  PAID
  UNPAID
}

// models
model User {
  id             Int     @id @default(autoincrement())
  name           String
  email          String  @unique(map: "User_email_key")
  password       String
  faceDescriptor Json?
  role           String  @default("EMPLOYEE")
  employeeId     String? @unique

  gender      Gender?
  dob         DateTime? @db.Date
  phoneNumber String?   @unique

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])
  designation  String?

  isActive      Boolean @default(true)
  monthlySalary Float?
  basicSalary   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  attendances    Attendance[]
  attendanceLogs AttendanceLog[] @relation("changedBy")
  leaves         Leave[]
  approvedLeaves Leave[]         @relation("approvedBy")
  leaveBalance   LeaveBalance[]
  payrolls       Payroll[]
}

model Session {
  id        Int      @id @default(autoincrement())
  valid     Boolean  @default(true)
  ip        String
  userAgent String
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Session_userId_fkey")

  @@index([userId], map: "Session_userId_idx")
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Attendance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       DateTime

  checkIn  DateTime?
  checkOut DateTime?

  checkInLat  Float?
  checkInLng  Float?
  checkOutLat Float?
  checkOutLng Float?

  checkInImage  String?
  checkOutImage String?

  workingHours Float?
  status       AttendanceStatus

  employee       User            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceLogs AttendanceLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date]) // Ek employee ki ek hi din me ek attendance
}

model AttendanceLog {
  id           Int @id @default(autoincrement())
  attendanceId Int

  action    AttendanceAction
  oldStatus AttendanceStatus?
  newStatus AttendanceStatus?

  locationLat Float?
  locationLng Float?

  deviceInfo String?

  changedBy     Int?
  changedByUser User? @relation("changedBy", fields: [changedBy], references: [id])

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attendanceId])
}

model Holiday {
  id        Int      @id @default(autoincrement())
  name      String
  date      DateTime @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Leave {
  id         Int         @id @default(autoincrement())
  employeeId Int
  fromDate   DateTime
  toDate     DateTime
  type       LeaveType
  reason     String?
  status     LeaveStatus @default(PENDING)

  approvedBy     Int?
  approvedByUser User? @relation("approvedBy", fields: [approvedBy], references: [id])

  employee User @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveBalance {
  id         Int @id @default(autoincrement())
  employeeId Int
  year       Int

  casualLeft Int @default(12)
  sickLeft   Int @default(8)
  paidLeft   Int @default(10)

  employee User @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year])
}

model Payroll {
  id               Int      @id @default(autoincrement())
  employeeId       Int
  month            String
  grossSalary      Float
  pf               Float
  tax              Float
  netSalary        Float
  totalWorkingDays Int
  payableDays      Int
  employee         User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([employeeId, month])
}

model PasswordResetOtp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([email, otp])
  @@index([email])
}
